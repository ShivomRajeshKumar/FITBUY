# Required for /api/chat and profile extraction. Never expose this to the
# extension/browser — it must only ever live on this backend server.
ANTHROPIC_API_KEY=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

# Model used by the agent. Defaults to claude-sonnet-4-6 if unset.
ANTHROPIC_MODEL=claude-sonnet-4-6

# Port the Express server listens on.
PORT=8787

# "demo" (default) uses the bundled demo catalog for prices/alternatives so
# FitBY works with zero marketplace credentials. Set to "live" once you've
# wired a licensed price/product-data provider into
# src/services/priceCheck.ts (fetchLivePrices).
MARKETPLACE_MODE=demo

# Restrict CORS to your packed extension's origin in production, e.g.
# chrome-extension://<your-extension-id>. Defaults to "*" for local dev.
ALLOWED_ORIGIN=*




